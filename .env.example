# Copy to .env (never commit .env) or set these in your shell / host.

# Signs the session cookie that links a browser to its wardrobe. If unset, the app generates one
# once and keeps it in instance/secret_key, so wardrobes survive restarts. Set it explicitly in production.
SECRET_KEY=

# Port for `python app.py` (development server only; use a WSGI server such as waitress in production).
PORT=5004

# Seconds to wait between Google Trends queries in scripts/refresh_trends.py. Raise it if Google rate-limits you.
TRENDS_PAUSE=3
